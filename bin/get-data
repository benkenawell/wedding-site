#!/usr/bin/env bash

datafile="$(pwd)/srv/data/wedding-dates.json"
datafile="${1:-$datafile}"
if [ -d "$datafile" ]; then
  datafile="${datafile%/}/wedding-dates.json"
fi

if [ -f "$datafile" ]; then
  echo "file already exists $datafile" >&2
  exit 1
else
  echo "creating file at ${datafile}" >&2
  mkdir -p "$(dirname "$datafile")"
  bw get notes cc133347-89ae-49ce-9930-b4280017e17e >"${datafile}"
fi
